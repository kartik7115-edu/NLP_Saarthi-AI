ENV=development
API_HOST=0.0.0.0
API_PORT=8000
OFFLINE_ONLY=false

# Groq (OpenAI-compatible API) - LLM for grounded answer generation.
# Leave GROQ_API_KEY blank to use the offline answer engine only. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional overrides
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20

# Legacy Azure OpenAI (no longer used by the answer path; kept only for rollback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Bright Data SERP (optional; skipped if token or zone missing)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=

# Bright Data Datacenter Proxy (optional)
BRIGHTDATA_DC_HOST=
BRIGHTDATA_DC_PORT=
BRIGHTDATA_DC_USER=
BRIGHTDATA_DC_PASS=
